{
  "manifest_version": 3,
  "name": "AI Trading Copilot - Adaptive Multi-Market Assistant",
  "version": "2.1.0",
  "description": "In-page TradingView assistant for AI Trading Copilot: active chart detection, regime analysis, 3:1 net R:R ticket execution, and risk control alongside charting tools.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "*://*.tradingview.com/*",
    "*://tradingview.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Trading Copilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tradingview.com/*",
        "*://tradingview.com/*"
      ],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": [
        "*://*.tradingview.com/*",
        "*://tradingview.com/*"
      ]
    }
  ]
}
